# ---------------------------------------------------------------------------
# Backend environment sample — EVERY key `app/config.py` consumes, commented.
# Copy to `backend/.env` for bare-metal dev; in the Docker stack these arrive
# via docker-compose `environment:` blocks fed from the ROOT `.env`
# (see the root `.env.example` for the deployment-level knobs).
# Placeholders only — NEVER commit a real secret. (#61)
# ---------------------------------------------------------------------------

# --- Core services ---------------------------------------------------------
# Pre-#288 bare-metal dev DBs were named `mavrov` — keep your old name here if yours predates the rename.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/beaconfolio
OLLAMA_URL=http://localhost:11434
# SQLAlchemy async pool: size + burst overflow (60 total); echo logs every SQL statement.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_ECHO=false

# --- AI models (local Ollama; free, no key) --------------------------------
EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text emits 768-dim vectors; must match the pgvector column.
EMBEDDING_DIMENSIONS=768
GENERATION_MODEL=llama3.2
FAST_GENERATION_MODEL=llama3.2:1b

# --- Authentication (SECURITY #177) ----------------------------------------
# REQUIRED in production; backend refuses to start when empty/placeholder.
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=
# Local/E2E ONLY: random per-process secret instead of failing to start.
JWT_ALLOW_EPHEMERAL_SECRET=true
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- Email (all empty = email features skip gracefully) --------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
# Outbound SMTP connection bound (seconds) — a hung mail peer must not pin a worker thread (#69).
SMTP_TIMEOUT_SECONDS=10

# Public contact form budget (per client IP): it is a WRITE (DB row + owner email per request),
# so the default is deliberately tight — raise only if real traffic demands it (#69).
CONTACT_RATE_LIMIT_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=60
# Where owner notifications (CV requests, ...) are sent.
ADMIN_EMAIL=owner@example.com

# --- Messenger notification channels (#263; all empty = channel disabled) ---
# Project-namespaced (#141) — never the generic TELEGRAM_* names.
BEACONFOLIO_TELEGRAM_BOT_TOKEN=
BEACONFOLIO_TELEGRAM_CHAT_ID=
# Generic webhook (e.g. Slack/Discord incoming webhook URL) — this one alone
# already covers Slack, Discord, Mattermost, ntfy and Gotify (#431).
BEACONFOLIO_NOTIFY_WEBHOOK_URL=
# Matrix (#431) — self-hosted/federated chat; free. ALL THREE required, else
# the channel does not exist. Token: POST /_matrix/client/v3/login on your
# homeserver. Room id looks like !abcdef:matrix.org (invite the bot first).
BEACONFOLIO_MATRIX_HOMESERVER=
BEACONFOLIO_MATRIX_ACCESS_TOKEN=
BEACONFOLIO_MATRIX_ROOM_ID=
# SMS via a SELF-HOSTED gateway (#431) — an app on your own spare Android
# phone with your own SIM. Free, and there is no metered API credential.
# ALL FOUR required.
#   Supported gateway: sms-gate.app (https://sms-gate.app/) in LOCAL mode.
#   The URL is its send endpoint, e.g. http://192.168.1.50:8080/message, and
#   USER/PASSWORD are the Basic-auth credentials the app shows you.
#   NOT supported as drop-in URLs: httpSMS and textbee solve the same problem
#   but authenticate with an x-api-key HEADER and take different request
#   bodies, so they need their own channel class — pointing this at one gets a
#   channel that fails every send. Same for a CPaaS (Twilio/Vonage/
#   MessageBird): different payload, and per-message bills.
#   NOTE the example is http:// — Basic auth then crosses your LAN in the
#   clear. Prefer https:// or reach the phone over a tailnet/VPN.
BEACONFOLIO_SMS_GATEWAY_URL=
BEACONFOLIO_SMS_GATEWAY_USER=
BEACONFOLIO_SMS_GATEWAY_PASSWORD=
BEACONFOLIO_SMS_GATEWAY_TO=
# Outbound bound (seconds) for messenger/webhook calls.
NOTIFY_TIMEOUT_SECONDS=10

# --- Recruiter-communication features -------------------------------------
# Transparent translation of recruiter messages (#248); false = no background
# task is ever scheduled.
TRANSLATION_ENABLED=true
# ISO 639-1 language recruiter messages are translated INTO.
OWNER_LANGUAGE=en
# First-party engagement analytics (#249); false = no event rows, admin
# endpoints 404.
ENGAGEMENT_ANALYTICS_ENABLED=true
# Purge deletes events older than this many days (0 = keep nothing; negative =
# never purge).
ENGAGEMENT_RETENTION_DAYS=365
# Concurrency + admission caps for analytics writes (#326) — protect the shared
# DB pool from emit bursts; drops are counted, never queued unbounded.
ENGAGEMENT_MAX_CONCURRENT_WRITES=4
ENGAGEMENT_MAX_PENDING_EVENTS=1000

# --- Voice channel (#264) — browser voice messages, LOCAL Whisper ----------
# OFF by default: the first accepted message downloads a Whisper model, and the
# public endpoint 404s until you opt in. No API key exists for this feature;
# transcription runs in-process on the CPU (rule 10).
VOICE_MESSAGES_ENABLED=false
# Hard caps on the public upload. Bytes are enforced by a bounded read; the
# duration is checked against the browser's claim AND against the decoded audio.
VOICE_MESSAGE_MAX_BYTES=2097152
VOICE_MESSAGE_MAX_DURATION_SECONDS=90
# Per-client-IP budget for the upload (tighter than the contact form's 5/60s —
# a voice message costs storage plus seconds of CPU).
VOICE_RATE_LIMIT_REQUESTS=3
VOICE_RATE_LIMIT_WINDOW_SECONDS=60
# faster-whisper model: tiny | base | small | medium | large-v3 (`base` is the
# small-VPS default) and its CTranslate2 quantization.
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
# Where the weights are cached. In Docker this is the MOUNT TARGET of the
# `whisper_models` volume — changing it there means re-downloading the model on
# every container start, so both compose files pin it (the same reason
# LINKEDIN_COOKIES_DIR is not forwarded). On bare metal, any writable path.
WHISPER_MODEL_DIR=/data/whisper

# --- API ---------------------------------------------------------------------
API_PREFIX=/api/app
# Comma-separated CORS allowlist.
CORS_ORIGINS=http://localhost:4200,https://example.com

# --- Gemini (OPTIONAL paid tier; empty = free local Ollama fallback) -------
# Project-namespaced on purpose (#141): a generic GEMINI_API_KEY exported in
# a shell profile would silently bind a personal paid key into test stacks.
BEACONFOLIO_GEMINI_API_KEY=
# Fernet key encrypting the per-user Gemini key at rest (#143); empty = plaintext.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BEACONFOLIO_GEMINI_ENCRYPTION_KEY=
BEACONFOLIO_GEMINI_MODEL=gemini-2.5-flash
BEACONFOLIO_GEMINI_MODEL_FALLBACK=gemini-2.0-flash

# --- CV ----------------------------------------------------------------------
CV_VERSION=v1.0

# --- Site identity (#65) — rebrand a prebuilt image with env alone ---------
# Served to the public frontend at runtime via GET /api/app/config/site.
SITE_NAME=My Portfolio
SITE_URL=https://example.com
OWNER_NAME=Jane Doe
OWNER_HEADLINE=Software Engineer
OWNER_DESCRIPTION=Professional portfolio of Jane Doe, a Software Engineer.
# Comma-separated public profile URLs. ONE list, two consumers (#93): the
# JSON-LD `Person.sameAs` block AND the contact section's rendered links, so
# what a recruiter clicks and what a crawler follows cannot disagree. Any
# http(s) host works — GitHub/GitLab/Bitbucket/Codeberg/SourceHut and the usual
# socials get a curated label, anything else is labelled from its own domain.
SOCIAL_LINKS=https://linkedin.com/in/janedoe,https://github.com/janedoe
# Google Analytics measurement id; empty disables analytics.
BEACONFOLIO_ANALYTICS_ID=
# Google Tag Manager container id (e.g. GTM-XXXXXXX); empty disables GTM.
# When set it WINS over BEACONFOLIO_ANALYTICS_ID and the gtag install stands
# down — running both double-counts every pageview.
BEACONFOLIO_GTM_CONTAINER_ID=

# --- LinkedIn ingest (all optional; empty disables the integration) --------
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_PUBLIC_ID=
# Session cookies captured from a logged-in browser (see importer/README.md).
LINKEDIN_COOKIE_LI_AT=
LINKEDIN_COOKIE_JSESSIONID=
# Machine token authorizing the importer to POST /linkedin/import-post.
LINKEDIN_IMPORT_TOKEN=
# Persistent dir for the saved LinkedIn session (a mounted volume in Docker).
LINKEDIN_COOKIES_DIR=/data/linkedin_cookies

# --- Admin seeding (SECURITY #142) -----------------------------------------
DEFAULT_ADMIN_EMAIL=owner@example.com
# REQUIRED for a real deployment: password the "admin" account is seeded /
# rotated to on startup. Empty = no login-able admin is ever seeded.
ADMIN_PASSWORD=

# --- Profile data ------------------------------------------------------------
# Where the backend fetches the profile JSON assets (frontend container).
PROFILE_DATA_HTTP_BASE=http://frontend:80/assets

# --- Rate limiting (public unauthenticated GETs) ---------------------------
PROFILE_RATE_LIMIT_REQUESTS=100
PROFILE_RATE_LIMIT_WINDOW_SECONDS=60
# Tailored-link public writes (POST /for/{slug}/visit, GET /for/{slug}/cv) —
# between the contact form's 5 and the profile read's 100 (#250).
TAILORED_VISIT_RATE_LIMIT_REQUESTS=20
TAILORED_VISIT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Proxy trust + crawler policy ------------------------------------------
# Upstream CIDR(s) whose forwarded header is believed when keying per-client-IP
# rate limits (#273). Same value the proxy uses; EMPTY = trust nothing (bare dev).
TRUSTED_PROXY_CIDRS=172.16.0.0/12
# robots.txt stance toward AI crawlers: allow (default) or deny; anything else
# falls back to allow so a typo can't deindex the site.
AI_CRAWLER_POLICY=allow

# --- Operational timeouts (#207; defaults = previous literals) -------------
LLM_REQUEST_TIMEOUT_SECONDS=300
LLM_STREAM_TIMEOUT_SECONDS=30
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
OLLAMA_HEALTHCHECK_TIMEOUT_SECONDS=2
OLLAMA_PREFLIGHT_TIMEOUT_SECONDS=5.0
OLLAMA_STARTUP_CHECK_TIMEOUT_SECONDS=10
PROFILE_DATA_TIMEOUT_SECONDS=5
DB_RESTORE_TIMEOUT_SECONDS=300

# --- Bulk-import guards (#207) ---------------------------------------------
IMPORT_MAX_IMAGE_MB=10
IMPORT_MAX_POSTS_JSON_MB=10
IMPORT_MAX_POSTS_PER_REQUEST=500
