# Project specific
node_modules/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.log

# SSL — TLS material is provided at runtime (host mount / deploy secret); the proxy
# entrypoint self-signs a dev cert when none is present. Never commit real certs/keys.
certs/*.key
certs/*.pem
proxy/certs/
proxy/ssl/

# Scraper — persistent browser profile holds the live LinkedIn login session
scraper/.chrome-profile/
scraper/session.json
scraper/session.json.stale-*

# Importer — local processed-URN ledger (personal LinkedIn activity data)
importer/state.json



# Angular build cache (root-level, if a build ran outside frontend/)
.angular/
backend/perf/results/
.playwright-mcp/

# SonarQube local scanner workdir (scripts/sonar_local.sh, #359)
.scannerwork/
