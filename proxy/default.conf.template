# nginx site config TEMPLATE.
#
# server_name values are injected at container start by /entrypoint.sh via envsubst
# from the ${PUBLIC_SERVER_NAME} and ${ADMIN_SERVER_NAME} environment variables, plus
# ${PUBLIC_CANONICAL_HOST} (first public name) and ${PUBLIC_ALIAS_HOSTS} (the rest) derived from it
# (defaults preserve the canonical beaconfolio.com hostnames). A forker sets their own
# domain in the root .env — no edit to this file is needed. Only those two names are
# substituted, so nginx runtime variables ($host, $remote_addr, ...) are left intact.

# Compression for every response this proxy forwards (http context: this file is
# included inside http{}). `gzip_proxied any` is the load-bearing line: the host edge in
# front of this container adds a `Via` header, and nginx's default (`gzip_proxied off`)
# refuses to compress any request that carries one - measured on the live site, a 211 KB
# home page and its 49 KB stylesheet went out raw. text/html is always compressed.
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 512;
gzip_types text/plain text/css text/xml application/xml application/rss+xml application/atom+xml
           application/javascript text/javascript application/json application/ld+json
           application/manifest+json image/svg+xml font/ttf font/otf application/vnd.ms-fontobject;

# Default reject unknown hosts (HTTP)
server {
    listen 80 default_server;
    server_name _;
    return 444; # Connection Closed Without Response
}

# HTTP to HTTPS redirect for the public site. Straight to the CANONICAL host, so an alias
# (www.<domain>) costs one hop, not two.
server {
    listen 80;
    server_name ${PUBLIC_SERVER_NAME};
    return 301 https://${PUBLIC_CANONICAL_HOST}$request_uri;
}

# Alias hosts (e.g. www.<domain>) -> the canonical host, permanently. Without this the alias
# answered 200 with a full copy of the site: two hostnames, one page set, split ranking
# signals. Path and query are kept. Same certificate files as the main block (the host edge
# terminates real TLS; see the note there).
server {
    listen 443 ssl;
    server_name ${PUBLIC_ALIAS_HOSTS};
    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    return 301 https://${PUBLIC_CANONICAL_HOST}$request_uri;
}

# Main Application Server
server {
    listen 80; # For localhost
    # default_server on 443: the alias block above is defined first and would otherwise
    # silently become the 443 default, redirecting any unmatched Host instead of serving.
    listen 443 ssl default_server;
    server_name ${PUBLIC_CANONICAL_HOST} localhost 127.0.0.1;

    # Response headers for the public site. Declared at server level: no public location
    # below sets its own add_header (nginx drops inherited headers in a location that does),
    # so these reach every public response. HSTS has no includeSubDomains/preload on purpose -
    # sibling hostnames on the same domain are not this proxy's to commit. microphone=(self)
    # because the contact page records voice messages.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(self)" always;

    # SSL certificates. In CI/local, entrypoint.sh self-signs a dummy /CN=localhost
    # pair. In prod they come from whatever terminates TLS for this container:
    #   * shared-edge host (the documented topology) — the HOST edge terminates TLS
    #     and this hop is internal, so the dummy cert here is CORRECT, not a bug;
    #   * this proxy terminates — mount the real fullchain.pem/privkey.pem into
    #     /etc/nginx/ssl and publish 443.
    # Both blocks below read the SAME files, so one certificate must cover the
    # public AND the admin hostname (SAN). See docs/wiki/production-deployment.md.
    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # Health Check -> Backend
    location /health {
        proxy_pass http://backend:8000/api/app/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Open WebUI
    location /open/ {
        proxy_pass http://open-webui:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # LinkedIn post import: the ONE public-host endpoint whose legitimate body is
    # bigger than the 3m API default below. It accepts a post image (multipart,
    # raw bytes) up to IMPORT_MAX_IMAGE_MB = 10 MB (app/config.py), so at 3m the
    # importer's larger images died here with nginx's opaque HTML 413 before the
    # app could answer (seen importing a 3.8 MB feed image: HTTP 413 <html>).
    # Scoped to this exact path - an exact-match location - so every other public
    # route keeps the tight 3m cap; the endpoint itself needs X-Import-Token or an
    # admin JWT. Note the bound on an UNAUTHENTICATED request is this nginx limit
    # alone: the app reads the uploaded file fully (UploadFile.read) and checks its
    # size and the token only afterwards, so 11m is also the most a stranger can make
    # the stack buffer for one request to this one URL. 11m = the 10 MB image cap +
    # multipart framing/text fields.
    location = /api/app/linkedin/import-post {
        proxy_pass http://backend:8000/api/app/linkedin/import-post;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 11m;
    }

    # API
    location /api/app/ {
        proxy_pass http://backend:8000/api/app/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The APPLICATION owns the upload limit, not this hop (#264). nginx's
        # default client_max_body_size is 1m, which is BELOW the voice-message
        # cap (VOICE_MESSAGE_MAX_BYTES, 2 MB): a ~90s Opus recording is ~1.1 MB,
        # so the default silently turned the endpoint's structured
        # `413 {"detail": "..."}` into nginx's opaque HTML 413 and the app's cap
        # became unreachable through the proxy. Keep this strictly ABOVE the
        # largest public app cap so the app is the one that answers; the app
        # still bounds memory itself with a `read(max + 1)`.
        client_max_body_size 3m;
        # The AI endpoints stream NDJSON incrementally and the UI renders tokens
        # as they arrive. MEASURED (#198): nginx already forwarded incrementally
        # here without these directives — 365 chunks, first at 1.6s, spread over
        # 99s — so this is NOT a fix for observed buffering. It makes the
        # behaviour an explicit guarantee instead of an artefact of chunk sizes
        # versus nginx's default buffers, and removes the asymmetry with the
        # admin block, which has always set it.
        proxy_buffering off;
        proxy_cache off;
        # Generation can idle longer than nginx's 60s default between chunks on a
        # cold model (26s to first chunk was measured), so raise the read timeout
        # — this is the part with actual teeth for a slow local LLM.
        proxy_read_timeout 300;
    }

    # Frontend
    location / {
        proxy_pass http://frontend:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Admin Console — restricted subdomain (admin-frontend SPA + shared backend API).
# Served separately from the public site for isolation; never indexed.
# admin.localhost is used by local/CI E2E (resolves to loopback).
server {
    listen 80;
    listen 443 ssl;
    server_name ${ADMIN_SERVER_NAME};

    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # Access restriction. Loopback is always allowed (CI/E2E + on-box checks);
    # the included allowlist adds the operator's real IPs and the final deny.
    allow 127.0.0.1;
    allow ::1;
    include /etc/nginx/admin_allowlist.conf;

    # Admin must never be indexed by search engines.
    add_header X-Robots-Tag "noindex, nofollow" always;

    # API -> backend (single shared backend; admin authenticates with an admin JWT)
    location /api/app/ {
        proxy_pass http://backend:8000/api/app/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        # Same reasoning as the public block, with the admin uploads' own caps:
        # MAX_PROFILE_JSON_BYTES and MAX_PROFILE_PHOTO_BYTES are both 5 MB
        # (app/api/admin_profile.py) and a CV is a PDF — all above nginx's 1m
        # default, which would have rejected them here before the app ever saw
        # the request. Found while fixing the public case; one line, same class
        # of bug, so it is fixed rather than left as a trap for the next upload.
        client_max_body_size 6m;
    }

    # Admin SPA (static nginx container)
    location / {
        proxy_pass http://admin-frontend:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
