{
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "statusMessage": "Guard: checking for irreversible local/infra destruction...",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-destructive.sh\""
          },
          {
            "type": "command",
            "timeout": 15,
            "statusMessage": "Guard: free disk + one Docker stack...",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-stack-resources.sh\""
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "timeout": 1800,
            "statusMessage": "Pre-push: docs + backend + frontend test round...",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-push-tests.sh\""
          },
          {
            "type": "command",
            "if": "Bash(gh pr merge*)",
            "timeout": 30,
            "statusMessage": "Merge gate: review verdict + Closes-vs-acceptance-criteria...",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-merge-gate.sh\""
          }
        ]
      }
    ]
  }
}
