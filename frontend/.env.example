# ---------------------------------------------------------------------------
# Frontend environment sample (#61). Deliberately tiny: the Angular apps take
# ALL owner-facing configuration at RUNTIME from the backend
# (GET /api/app/config/site — identity, social links, analytics id; #65), so a
# prebuilt image is rebranded with backend env alone, never a rebuild. The env
# below covers the two processes that DO read env: the SSR Node server, and
# the one-shot social-image generator.
# ---------------------------------------------------------------------------

# SSR host allowlist (public app, projects/public/src/server.ts). Extra hosts
# the server answers for, space/comma separated; loopback + PUBLIC_SERVER_NAME
# derived hosts are handled by the proxy in the shipped topology.
NG_ALLOWED_HOSTS=

# Port the SSR Node server listens on inside the container. Compose sets no
# PORT; 4000 is the server's own fallback (projects/public/src/server.ts).
PORT=4000

# Set by both compose files.
NODE_ENV=production

# --- Social-card artwork (scripts/make-social-image.mjs, #311) --------------
# Build-time only and one-shot: these feed `node scripts/make-social-image.mjs`
# when regenerating docs/assets social cards — they never reach the served
# apps. A forker overrides all five or ships owner-branded cards (defaults
# shown are the upstream brand).
BRAND_NAME=BEACONFOLIO
BRAND_HOST=beaconfolio
BRAND_TAGLINE=fork-and-go portfolio + recruiter comms for engineers
BRAND_FEATURES=semantic search,local AI,recruiter inbox,self-hosted
BRAND_URL=github.com/mavrovde/beaconfolio
