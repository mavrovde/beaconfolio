# ---------------------------------------------------------------------------
# Frontend environment sample (#61). Deliberately tiny: the Angular apps take
# ALL owner-facing configuration at RUNTIME from the backend
# (GET /api/app/config/site — identity, social links, analytics id; #65), so a
# prebuilt image is rebranded with backend env alone, never a rebuild. The only
# env the frontend processes read is the SSR Node server's own:
# ---------------------------------------------------------------------------

# SSR host allowlist (public app, projects/public/src/server.ts). Extra hosts
# the server answers for, space/comma separated; loopback + PUBLIC_SERVER_NAME
# derived hosts are handled by the proxy in the shipped topology.
NG_ALLOWED_HOSTS=

# Port the SSR Node server listens on inside the container (compose default).
PORT=4000

# Set by both compose files; no other build-time configuration exists.
NODE_ENV=production
