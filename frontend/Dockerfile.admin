# Multi-stage build for the Angular ADMIN app (CSR-only SPA, no SSR/Node runtime)
FROM node:26-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies using cache mount for npm
RUN --mount=type=cache,target=/root/.npm \
    npm install --legacy-peer-deps

# Copy source code
COPY . .

# Build the admin SPA (and the shared library it depends on)
RUN npm run build:shared && npm run build:admin

# Production stage: static files served by nginx only (no Node process)
FROM nginx:1.31-alpine

# Take Alpine OS security fixes the base image has not been rebuilt with yet
# (Snyk flagged zlib/expat), then clear default nginx assets and config.
RUN apk upgrade --no-cache \
    && rm -rf /usr/share/nginx/html/* && rm -f /etc/nginx/conf.d/default.conf

# Copy built admin SPA
COPY --from=builder /app/dist/admin/browser /usr/share/nginx/html

# Copy nginx configuration (SPA fallback + API proxy)
COPY nginx.admin.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
