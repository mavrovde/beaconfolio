{
  "name": "frontend",
  "version": "1.17.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve public",
    "start:admin": "ng serve admin",
    "build:shared": "ng build shared",
    "build:public": "ng build public",
    "build:admin": "ng build admin",
    "build": "npm run build:shared && npm run build:public && npm run build:admin",
    "watch": "ng build public --watch --configuration development",
    "test:shared": "vitest run --config projects/shared/vitest.config.ts",
    "test:public": "vitest run --config projects/public/vitest.config.ts",
    "test:admin": "vitest run --config projects/admin/vitest.config.ts",
    "test": "npm run test:shared && npm run test:public && npm run test:admin",
    "test:coverage:shared": "vitest run --coverage --config projects/shared/vitest.config.ts",
    "test:coverage:public": "vitest run --coverage --config projects/public/vitest.config.ts",
    "test:coverage:admin": "vitest run --coverage --config projects/admin/vitest.config.ts",
    "lint": "node scripts/make-social-image.test.mjs && node scripts/eslint-cd-safety.test.mjs && eslint .",
    "test:coverage": "npm run test:coverage:shared && npm run test:coverage:public && npm run test:coverage:admin",
    "e2e": "npx playwright test",
    "serve:ssr:public": "node dist/public/server/server.mjs",
    "lint:eslint": "eslint ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "express": "^5.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.4",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
